<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Keep local-file playback alive when the screen locks or the app goes to the background. -->
  <key>UIBackgroundModes</key>
  <array>
    <string>audio</string>
  </array>

  <!-- The web app may be served over plain http on a LAN. NSAllowsLocalNetworking covers local
       addresses only; https (for example a Tailscale certificate) is what the app prefers. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
  <key>NSLocalNetworkUsageDescription</key>
  <string>rune connects to the music server running on your computer, over Tailscale or your home network.</string>

  <key>UIStatusBarStyle</key>
  <string>UIStatusBarStyleLightContent</string>
</dict>
</plist>
