#!/bin/sh
# rune's updater for the Linux download.
#   rune-update            update now if a newer version is out
#   rune-update --check    at most once a day: if a newer version is out, ask on the desktop, and update on yes
set -eu
REPO=jfj-oss/rune
ASSET=rune-linux-x86_64.tar.gz
A=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/rune-app
mkdir -p "$STATE"
N="$A/node/bin/node"; H="$A/bin/helper.mjs"
have=$(cat "$A/VERSION")
newer() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]; }
ask() {
  if command -v kdialog >/dev/null; then kdialog --title rune --yesno "$1"
  elif command -v zenity >/dev/null; then zenity --question --title=rune --text="$1"
  else notify-send rune "$1 Run: rune-update" 2>/dev/null; return 1; fi
}
if [ "${1:-}" = --check ]; then
  stamp="$STATE/update-checked"
  [ -n "$(find "$stamp" -mmin -1440 2>/dev/null)" ] && exit 0
  touch "$stamp"
  latest=$("$N" "$H" latest "$REPO") || exit 0
  newer "$latest" "$have" || exit 0
  [ "$(cat "$STATE/update-declined" 2>/dev/null)" = "$latest" ] && exit 0
  if ! ask "rune $latest is available (you have $have). Update now? rune restarts when it is done."; then echo "$latest" > "$STATE/update-declined"; exit 0; fi
else
  latest=$("$N" "$H" latest "$REPO") || { echo "Could not reach GitHub." >&2; exit 1; }
  newer "$latest" "$have" || { echo "rune $have is the newest."; exit 0; }
fi
W=$(mktemp -d); trap 'rm -rf "$W"' EXIT
base=https://github.com/$REPO/releases/download/v$latest
echo "Downloading rune $latest..."
"$N" "$H" download "$base/$ASSET" "$W/$ASSET"
"$N" "$H" download "$base/$ASSET.sha256" "$W/$ASSET.sha256"
(cd "$W" && sha256sum -c "$ASSET.sha256" >/dev/null) || { echo "The download is damaged; nothing was changed." >&2; exit 1; }
tar -xzf "$W/$ASSET" -C "$W"
"$W/rune-linux-x86_64/install.sh" --yes --update
notify-send rune "rune $latest is installed." 2>/dev/null || true
# a running app is started again on the new version
if pgrep -x rune-desktop >/dev/null; then pkill -x rune-desktop; sleep 1; (setsid "$A/bin/rune" >/dev/null 2>&1 &); fi
